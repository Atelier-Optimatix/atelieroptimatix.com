---
interface Props {
	level?: 1 | 2 | 3 | 4 | 5 | 6;
	tag?: 1 | 2 | 3 | 4 | 5 | 6;
	class?: string;
	[key: string]: unknown;
}

// `__collectHeading` is Markdoc's marker telling Astro's collector that this
// component is a heading. It must not reach the DOM as an attribute.
let {
	level = 2,
	tag,
	class: className,
	__collectHeading,
	...rest
} = Astro.props as Props;

tag = tag ?? level;

const Element = `h${tag}` as const;
---

<Element
	class:list={[
		level === 1 && "sm:text-6xl text-5xl xl:text-8xl",
		level === 2 && "sm:text-4xl text-3xl xl:text-5xl",
		level === 3 && "text-3xl md:text-4xl",
		level === 4 && "text-xl md:text-2xl",
		level === 5 && "text-lg md:text-xl",
		level === 6 && "text-lg md:text-xl",
		className,
	]}
	{...rest}
>
	<slot />
</Element>
