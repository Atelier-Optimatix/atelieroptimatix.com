---
import Title from "@/components/primitives/Title.astro";
import DocsShell from "@/layouts/DocsShell.astro";
import { getDocsNav } from "@/lib/docs-nav";

const nav = await getDocsNav();
const pageCount = nav.reduce(
	(total, group) =>
		total + group.sections.reduce((sum, section) => sum + section.docs.length, 0),
	0,
);
---

<DocsShell>
	<div data-pagefind-ignore>
		<Title level={1}>User Guide</Title>
		<p class="max-w-2xl pt-6 text-base text-slate-500">
			{pageCount} pages covering EduConnect and its KinderCare deployment, the admissions portal
			and the parent apps. Search above, or browse below.
		</p>

		<div class="flex flex-wrap gap-3 pt-8">
			<a
				href="/docs/educonnect-overview"
				class="rounded-full bg-black px-4 py-2 text-sm font-medium text-white hover:bg-slate-800"
				>Start here</a
			>
			<a
				href="/docs/educonnect-setting-up-a-new-institute"
				class="rounded-full border border-slate-200 px-4 py-2 text-sm font-medium text-black hover:border-slate-400"
				>Set up a new institute</a
			>
			<a
				href="/docs/educonnect-teacher-getting-started"
				class="rounded-full border border-slate-200 px-4 py-2 text-sm font-medium text-black hover:border-slate-400"
				>I'm a teacher</a
			>
		</div>

		{
			nav.map((group) => (
				<section class="pt-16">
					<h2 class="text-2xl tracking-tighter text-black">{group.label}</h2>
					<p class="max-w-2xl pt-2 text-sm text-slate-500">{group.blurb}</p>

					{group.sections.map((section) => (
						<div class="pt-8">
							<h3 class="pb-3 text-xs font-semibold uppercase tracking-wide text-slate-400">
								{section.section}
							</h3>
							<ul class="grid gap-x-8 gap-y-4 sm:grid-cols-2">
								{section.docs.map((doc) => (
									<li>
										<a href={doc.href} class="group block">
											<span class="text-base text-black group-hover:underline">
												{doc.title}
											</span>
											<span class="block pt-1 text-sm leading-snug text-slate-500">
												{doc.description}
											</span>
										</a>
									</li>
								))}
							</ul>
						</div>
					))}
				</section>
			))
		}
	</div>
</DocsShell>
